APP_NAME="OlivarCalc API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# All user-facing text is Spanish (spec §0.1).
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (spec §6). Local: DBNGIN's MySQL 8 on the host. utf8mb4 throughout.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=olivarcalc
DB_USERNAME=olivarcalc
DB_PASSWORD=olivarcalc
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Spec §7.5: cookie auth for the web app on a sibling subdomain.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cache and queue. Redis is the production backend (spec §2), but nothing falls
# back automatically: leaving these as `redis` without a local Redis makes every
# endpoint 500. Start Redis (Herd or DBNGIN) and keep `redis` for speed, or use
# `database` to work with no extra service. The test suite overrides both in
# phpunit.xml regardless.
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (Herd ships it on SMTP 1025, web UI 8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@olivarcalc.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Spec §7.5 / §13.5 -------------------------------------------------
# Comma-separated. Local default matches the Astro dev server.
FRONTEND_URL=http://localhost:4321
SANCTUM_STATEFUL_DOMAINS=localhost:4321,127.0.0.1:4321
CORS_ALLOWED_ORIGINS=http://localhost:4321
SESSION_SECURE_COOKIE_LOCALHOST=true

# Google OAuth. Empty locally: the button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
# JSON array of iOS/Android client IDs used to verify mobile id_token.
GOOGLE_MOBILE_CLIENT_IDS=[]

# Brevo (SMTP/API) for transactional mail.
BREVO_API_KEY=
MAIL_MAILER_BREVO=
MAIL_HOST_BREVO=smtp-relay.brevo.com
MAIL_PORT_BREVO=587

# Expo push notifications (optional).
EXPO_ACCESS_TOKEN=

# Cloudflare Pages deploy hook, fired by RequestSiteRebuild.
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=

# Spec §8: the POOLred importer. The owner confirmed the terms of use on
# 2026-10-07, so this may be switched on in an environment that has that
# permission. Off by default so a checkout without it never calls their API.
#
# It reads two endpoints that need no credentials, and nothing else:
#   - api.poolred.com/v1/ipool/extra  (a year of daily index values)
#   - poolred.com/wp-json/poolred-ticker/v1/datos  (variation, four indices)
#
# The other three indices answer 401 without a session token from POOLred's own
# widget bundle. That token is not used: it rotates per session and using it would
# be working around an access control. Ask POOLred for an API key instead.
# See DECISIONS.md ADR-0013.
POOLRED_IMPORT_ENABLED=false

# Overridable for a fork or a mirror. Left unset, the defaults are POOLred's.
# POOLRED_INDEX_BASE=https://api.poolred.com/v1/ipool
# POOLRED_INDEX=extra
# POOLRED_TICKER_URL=https://poolred.com/wp-json/poolred-ticker/v1/datos
# POOLRED_SOURCE_URL=https://poolred.com/

SENTRY_LARAVEL_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=olivarcalc-api
